# ==========================
# Application
# ==========================
NODE_ENV=development
PORT=3000
APP_NAME="Auth System"
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ==========================
# Database (SQLite)
# ==========================
# Relative path is resolved from the directory where the process is started
# Use absolute path in production (e.g., /data/auth.db)
DATABASE_URL="file:./data/auth.db"

# ==========================
# JWT
# ==========================
JWT_ACCESS_SECRET=replace_with_a_strong_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_strong_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ==========================
# Password Hashing (Argon2id)
# ==========================
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ==========================
# Cookies
# ==========================
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ==========================
# CSRF
# ==========================
CSRF_SECRET=replace_with_another_strong_random_string_min_32_chars
CSRF_COOKIE_NAME=x-csrf-token
CSRF_HEADER_NAME=x-csrf-token

# ==========================
# Rate Limiting
# ==========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ==========================
# Email
# ==========================
EMAIL_FROM=no-reply@example.com
EMAIL_ENABLED=false

# ==========================
# Logging
# ==========================
LOG_LEVEL=info